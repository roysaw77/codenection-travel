[{"background":{"fill":"#173F3A"},"elements":[{"geometry":"textbox","position":{"left":1160,"top":667,"width":55,"height":28},"fill":"none","line":{"fill":"none","width":0},"value":"01","style":{"typeface":"Arial","fontSize":17,"color":"#BDCCC6","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":72,"top":175,"width":1080,"height":190},"fill":"none","line":{"fill":"none","width":0},"value":"Senior Travel\nCompanion","style":{"typeface":"Arial","fontSize":76,"color":"#FFFFFF","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":78,"top":420,"width":950,"height":110},"fill":"none","line":{"fill":"none","width":0},"value":"Helping families support older parents\nbefore and during a tour","style":{"typeface":"Arial","fontSize":34,"color":"#D4E4DD","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":78,"top":610,"width":950,"height":40},"fill":"none","line":{"fill":"none","width":0},"value":"Hackathon concept and UI prototype","style":{"typeface":"Arial","fontSize":22,"color":"#BBD0C6","bold":false,"autoFit":"none"}}],"speakerNotes":{"textFrame":{}},"shapes":{},"images":{},"notes":"Timing: 20 seconds.\nSenior Travel Companion helps adult children support older parents when they cannot travel together. We focus on parents aged sixty and above who join organised tours. The child helps choose the trip, the parent uses a simple interface, and the guide provides local support. This is our proposed product, illustrated through a UI prototype."},{"background":{"fill":"#F7F8F3"},"elements":[{"geometry":"textbox","position":{"left":64,"top":45,"width":1152,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"The family support gap","style":{"typeface":"Arial","fontSize":44,"color":"#173F3A","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":1160,"top":667,"width":55,"height":28},"fill":"none","line":{"fill":"none","width":0},"value":"02","style":{"typeface":"Arial","fontSize":17,"color":"#566C66","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":161,"width":1100,"height":125},"fill":"none","line":{"fill":"none","width":0},"value":"“Can Mum manage the trip,\nand who can help if plans change?”","style":{"typeface":"Arial","fontSize":40,"color":"#173F3A","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":72,"top":350,"width":510,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Before the trip","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":72,"top":399,"width":510,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Suitability and important tour details\ncan be difficult to assess.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":686,"top":350,"width":510,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"During the trip","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":686,"top":399,"width":510,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Children need context. Parents need\nan easy way to request support.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":72,"top":594,"width":1120,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Primary user / intended payer: adult child     End user: parent aged 60+","style":{"typeface":"Arial","fontSize":22,"color":"#566C66","bold":false,"autoFit":"none"}}],"speakerNotes":{"textFrame":{}},"shapes":{},"images":{},"notes":"Timing: 30 seconds.\nImagine a daughter arranging a holiday for her mother, who prefers short walks. A tour listing may look suitable, but she still needs to understand walking demands and the evidence behind the operator. During the trip, a missed reply gives little context. The parent also needs a simple way to ask for help. These are hypotheses we will validate through family and guide interviews."},{"background":{"fill":"#F7F8F3"},"elements":[{"geometry":"textbox","position":{"left":64,"top":45,"width":1152,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Tour matching with reasons","style":{"typeface":"Arial","fontSize":44,"color":"#173F3A","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":1160,"top":667,"width":55,"height":28},"fill":"none","line":{"fill":"none","width":0},"value":"03","style":{"typeface":"Arial","fontSize":17,"color":"#566C66","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":170,"width":550,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"AI Senior Tour Matcher","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":219,"width":550,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Parent preferences compared\nwith tour requirements.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":320,"width":550,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"AI Travel Advisor","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":369,"width":550,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Suitability Score with reasons,\nmismatches and unknowns.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":470,"width":550,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Tour Trust Profile","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":519,"width":550,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Guide, licence, insurance, hotel\nand transport evidence.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"contentType":"image/png","alt":"v2-03-advisor","fit":"contain","position":{"left":690,"top":148,"width":245,"height":495},"kind":"image"},{"contentType":"image/png","alt":"v2-04-trust","fit":"contain","position":{"left":948,"top":148,"width":245,"height":495},"kind":"image"}],"speakerNotes":{"textFrame":{}},"shapes":{},"images":{},"notes":"Timing: 40 seconds.\nThe child enters a parent profile with walking tolerance, rest needs, language and budget. The proposed matcher compares it with tour, guide, itinerary and safety information. Explicit rules calculate suitability, while the AI advisor explains the fit and missing information. For example, a forty-minute walk should be flagged for a parent who prefers twenty minutes. The Trust Profile shows supporting evidence and review status. Our displayed scores are fixed demo values, and neither suitability nor a trust profile guarantees safety."},{"background":{"fill":"#F7F8F3"},"elements":[{"geometry":"textbox","position":{"left":64,"top":45,"width":1152,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Simple actions for older travellers","style":{"typeface":"Arial","fontSize":44,"color":"#173F3A","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":1160,"top":667,"width":55,"height":28},"fill":"none","line":{"fill":"none","width":0},"value":"04","style":{"typeface":"Arial","fontSize":17,"color":"#566C66","bold":false,"autoFit":"none"}},{"contentType":"image/png","alt":"v2-07-parent","fit":"contain","position":{"left":100,"top":150,"width":270,"height":505},"kind":"image"},{"geometry":"textbox","position":{"left":475,"top":182,"width":690,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"One clear next step","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":475,"top":231,"width":690,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Next stop and meeting information\non the home screen.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":475,"top":342,"width":690,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Easy check-in","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":475,"top":391,"width":690,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"A prominent “I’m OK” action.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":475,"top":492,"width":690,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Help within reach","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":475,"top":541,"width":690,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Call guide or open SOS / Help.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}}],"speakerNotes":{"textFrame":{}},"shapes":{},"images":{},"notes":"Timing: 35 seconds.\nParents should not need to learn a complex dashboard. Senior Simple Mode brings the next stop and meeting details to the main screen. The largest action lets them say I am okay. Calling the guide and requesting help remain easy to find. We use short labels and prominent controls, with detailed planning in the child view. We still need usability testing with older adults, including text scaling and whether users understand the help actions.\nSources: https://www.w3.org/WAI/older-users/ and https://www.w3.org/WAI/WCAG22/Understanding/target-size-enhanced.html"},{"background":{"fill":"#F7F8F3"},"elements":[{"geometry":"textbox","position":{"left":64,"top":45,"width":1152,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Shared context when help is needed","style":{"typeface":"Arial","fontSize":44,"color":"#173F3A","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":1160,"top":667,"width":55,"height":28},"fill":"none","line":{"fill":"none","width":0},"value":"05","style":{"typeface":"Arial","fontSize":17,"color":"#566C66","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":190,"width":570,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Child Dashboard","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":239,"width":570,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Itinerary, map preview and latest status\nin the same trip view.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":350,"width":570,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Smart Safety Alerts","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":399,"width":570,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"SOS, overdue check-ins and\npossible route deviations.","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":520,"width":570,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Guide assists locally.\nChild follows the response remotely.","style":{"typeface":"Arial","fontSize":28,"color":"#173F3A","bold":true,"autoFit":"none"}},{"contentType":"image/png","alt":"v2-05-dashboard","fit":"contain","position":{"left":695,"top":148,"width":243,"height":495},"kind":"image"},{"contentType":"image/png","alt":"v2-06-alerts","fit":"contain","position":{"left":952,"top":148,"width":243,"height":495},"kind":"image"}],"speakerNotes":{"textFrame":{}},"shapes":{},"images":{},"notes":"Timing: 35 seconds.\nThe child dashboard combines the itinerary with the latest check-in and a future trip map. The map concept shows the parent’s consented shared location, the next stop and the update time. It uses an illustrative map in this prototype and has no live tracking. If a parent requests rest or sends SOS, the proposed alert workflow contacts the authorised guide and child. The guide can respond locally while the child supports remotely. The app must show stale data and separate acknowledgements. These screenshots simulate the workflow. They do not send notifications or provide emergency response."},{"background":{"fill":"#F7F8F3"},"elements":[{"geometry":"textbox","position":{"left":64,"top":45,"width":1152,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Our proposed difference","style":{"typeface":"Arial","fontSize":44,"color":"#173F3A","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":1160,"top":667,"width":55,"height":28},"fill":"none","line":{"fill":"none","width":0},"value":"06","style":{"typeface":"Arial","fontSize":17,"color":"#566C66","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":75,"top":160,"width":790,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"TourRadar","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":75,"top":209,"width":790,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Tour discovery and physical ratings","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"contentType":"image/png","alt":"logo:tourradar.png","fit":"contain","position":{"left":960,"top":153,"width":220,"height":60},"kind":"image"},{"geometry":"textbox","position":{"left":75,"top":282,"width":790,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"TripIt","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":75,"top":331,"width":790,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Travel plans and itinerary sharing","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"contentType":"image/png","alt":"logo:tripit-clean.png","fit":"contain","position":{"left":955,"top":268,"width":225,"height":76},"kind":"image"},{"geometry":"textbox","position":{"left":75,"top":404,"width":790,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Life360","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":75,"top":453,"width":790,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Family location sharing and SOS","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"contentType":"image/png","alt":"logo:life360.png","fit":"contain","position":{"left":955,"top":401,"width":225,"height":60},"kind":"image"},{"geometry":"textbox","position":{"left":75,"top":558,"width":1100,"height":92},"fill":"none","line":{"fill":"none","width":0},"value":"Our focus: parent-specific tour selection\nconnected to family and guide support","style":{"typeface":"Arial","fontSize":34,"color":"#173F3A","bold":true,"autoFit":"none"}}],"speakerNotes":{"textFrame":{}},"shapes":{},"images":{},"notes":"Timing: 30 seconds.\nExisting products already solve useful parts of this problem. TourRadar offers senior tours and physical ratings. TripIt organises and shares itineraries. Life360 supports location sharing and SOS. Our proposed difference is joining parent-specific tour selection with support during travel, connecting the parent, child and guide. We are not claiming these individual features are unique. We need to validate whether this connected workflow matters enough for families to adopt and pay for.\nSources: https://www.tourradar.com/pa/seniors ; https://help.tourradar.com/en/operators/group-type-guide-type-physical-ratings ; https://help.tripit.com/en/support/solutions/articles/103000063304-getting-started ; https://www.life360.com/location-sharing ; https://support.life360.com/hc/en-us/articles/23053474049687-SOS-Alerts\nLogo sources: https://www.tourradar.com/press ; https://www.tripit.com/themes/custom/tripit_theme/images/logo-tripit.svg ; https://commons.wikimedia.org/wiki/File:Life360_Horizontal.svg"},{"background":{"fill":"#F7F8F3"},"elements":[{"geometry":"textbox","position":{"left":64,"top":45,"width":1152,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"A focused implementation stack","style":{"typeface":"Arial","fontSize":44,"color":"#173F3A","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":1160,"top":667,"width":55,"height":28},"fill":"none","line":{"fill":"none","width":0},"value":"07","style":{"typeface":"Arial","fontSize":17,"color":"#566C66","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":165,"width":510,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Flutter","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":214,"width":510,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Parent, child and guide interfaces","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":690,"top":165,"width":510,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"FastAPI + Supabase","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":690,"top":214,"width":510,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"APIs, trip data and access controls","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":335,"width":510,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"LangChain + NVIDIA NIM","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":384,"width":510,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Evidence-based match explanations","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":690,"top":335,"width":510,"height":42},"fill":"none","line":{"fill":"none","width":0},"value":"Geoapify Routing API","style":{"typeface":"Arial","fontSize":29,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":690,"top":384,"width":510,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"Proposed route distance and duration","style":{"typeface":"Arial","fontSize":25,"color":"#173F3A","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":535,"width":1130,"height":70},"fill":"none","line":{"fill":"none","width":0},"value":"FCM + persistent worker for notifications and scheduled checks","style":{"typeface":"Arial","fontSize":28,"color":"#176658","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":70,"top":617,"width":1120,"height":40},"fill":"none","line":{"fill":"none","width":0},"value":"Planned stack. Current prototype uses HTML, CSS and JavaScript.","style":{"typeface":"Arial","fontSize":22,"color":"#566C66","bold":false,"autoFit":"none"}}],"speakerNotes":{"textFrame":{}},"shapes":{},"images":{},"notes":"Timing: 30 seconds.\nOur planned frontend is Flutter, backed by FastAPI and Supabase for profiles, trips and permissions. LangChain sends relevant evidence to NVIDIA NIM to explain matches. Backend rules control scoring and alerts. For routing, Geoapify is a lower-cost MVP candidate, subject to local coverage tests. FCM and a persistent worker handle notifications and overdue events. The existing demo uses HTML, CSS and JavaScript. These integrations are planned, and we will confirm provider limits before implementation.\nSources: https://docs.flutter.dev/platform-integration/web ; https://supabase.com/docs/guides/database/overview ; https://docs.langchain.com/oss/python/langchain/structured-output ; https://docs.api.nvidia.com/nim/re/reference/llm-apis ; https://www.geoapify.com/pricing/ ; https://firebase.google.com/docs/cloud-messaging"},{"background":{"fill":"#173F3A"},"elements":[{"geometry":"textbox","position":{"left":64,"top":45,"width":1152,"height":90},"fill":"none","line":{"fill":"none","width":0},"value":"The next milestone","style":{"typeface":"Arial","fontSize":44,"color":"#FFFFFF","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":1160,"top":667,"width":55,"height":28},"fill":"none","line":{"fill":"none","width":0},"value":"08","style":{"typeface":"Arial","fontSize":17,"color":"#BDCCC6","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":75,"top":177,"width":1110,"height":145},"fill":"none","line":{"fill":"none","width":0},"value":"One profile. One suitable tour.\nOne shared trip.","style":{"typeface":"Arial","fontSize":53,"color":"#FFFFFF","bold":true,"autoFit":"none"}},{"geometry":"textbox","position":{"left":78,"top":391,"width":1110,"height":100},"fill":"none","line":{"fill":"none","width":0},"value":"Next: working check-ins across two devices\nThen: guide response and older-user testing","style":{"typeface":"Arial","fontSize":31,"color":"#D4E4DD","bold":false,"autoFit":"none"}},{"geometry":"textbox","position":{"left":78,"top":577,"width":1100,"height":50},"fill":"none","line":{"fill":"none","width":0},"value":"Current status: UI prototype with sample data","style":{"typeface":"Arial","fontSize":25,"color":"#BDCCC6","bold":false,"autoFit":"none"}}],"speakerNotes":{"textFrame":{}},"shapes":{},"images":{},"notes":"Timing: 20 seconds.\nOur next milestone is one working trip across two devices: a child creates a profile, reviews a match and receives a parent check-in. Then we test guide acknowledgement and usability with older adults. Today we have the interface concept. Our goal is to help families choose a suitable tour and stay connected when they cannot travel together."}]